{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "lib": ["ES2022", "DOM"],
    "baseUrl": ".",
    "paths": { "@five-days/protocol": ["demos/vendor/protocol/index.ts"] }
  },
  "include": ["demos/*.ts"]
}
